<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="contentHolder" prefHeight="551.0" prefWidth="619.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label fx:id="currentCashier" text="Caixa Atual">
               <font>
                  <Font size="20.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" top="20.0" />
               </HBox.margin>
            </Label>
            <Label fx:id="expectedTransfer" text="Repasse esperado">
               <font>
                  <Font size="20.0" />
               </font>
               <HBox.margin>
                  <Insets left="60.0" top="20.0" />
               </HBox.margin>
            </Label>
            <Button fx:id="btIncreaseTransfer" mnemonicParsing="false" text="+">
               <HBox.margin>
                  <Insets left="5.0" top="20.0" />
               </HBox.margin>
            </Button>
            <Label fx:id="currentCashierPlusTransfer" text="Caixa + Repasse">
               <HBox.margin>
                  <Insets left="80.0" top="20.0" />
               </HBox.margin>
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox prefHeight="36.0" prefWidth="612.0">
         <children>
            <Button fx:id="btNewOrder" mnemonicParsing="false" text="Adicionar Compra">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" top="20.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <HBox prefHeight="28.0" prefWidth="612.0">
         <VBox.margin>
            <Insets top="150.0" />
         </VBox.margin>
         <children>
            <Label text="Top 5 gastos em itens">
               <HBox.margin>
                  <Insets left="44.0" />
               </HBox.margin>
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <Label text="Top 5 Gastos Locais">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
               <HBox.margin>
                  <Insets left="206.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
      <HBox prefHeight="202.0" prefWidth="612.0">
         <children>
            <TableView fx:id="tableViewRankingItems" prefHeight="200.0" prefWidth="200.0">
               <columns>
                  <TableColumn fx:id="tableColumnItemName" prefWidth="75.0" text="Nome" />
                  <TableColumn fx:id="tableColumnItemValue" prefWidth="75.0" text="Valor" />
               </columns>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </TableView>
            <TableView fx:id="tableViewRankingLocation" prefHeight="200.0" prefWidth="200.0">
               <columns>
                  <TableColumn fx:id="tableColumnLocationName" prefWidth="75.0" text="Nome" />
                  <TableColumn fx:id="tableColumnLocationValue" prefWidth="75.0" text="Valor" />
               </columns>
               <HBox.margin>
                  <Insets left="150.0" />
               </HBox.margin>
            </TableView>
         </children>
      </HBox>
   </children>
</VBox>
